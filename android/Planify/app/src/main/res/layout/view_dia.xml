<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1B1B1B"
    android:paddingTop="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnatrasDia"
            app:layout_constraintBottom_toTopOf="@id/includeEventosDia"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/calendar_title"
            android:backgroundTint="#1B1B1B"
            android:gravity="center"
            android:drawableStart="@drawable/flecha_atras"
            android:fontFamily="@font/anton"
            android:textSize="16dp"
            android:textColor="#8A8A8A"
            />

        <TextView
            android:id="@+id/menu_lateral_dia"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintEnd_toStartOf="@id/textoFechaCalendarioDia"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:id="@+id/textoFechaCalendarioDia"
            android:text=""
            android:fontFamily="@font/anton"
            android:textSize="24dp"
            android:textColor="@android:color/white"
            android:background="@drawable/calendar_title"
            android:backgroundTint="#1B1B1B"
            app:layout_constraintStart_toEndOf="@id/menu_lateral_dia"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <include
            android:id="@+id/includeEventosDia"
            layout="@layout/scroll_eventos_dia"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/textoFechaCalendarioDia"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
            />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCrearTarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:srcCompat="@drawable/ic_add"
        app:tint="@android:color/white"
        app:backgroundTint="#1B1B1B"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_margin="20dp" />



</androidx.constraintlayout.widget.ConstraintLayout>