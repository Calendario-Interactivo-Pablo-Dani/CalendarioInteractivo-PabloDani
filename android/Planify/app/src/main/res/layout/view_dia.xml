<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1B1B1B"
    android:paddingTop="20dp">

    <TextView
        android:id="@+id/menu_lateral_dia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/menu_treslineas"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="@id/btnatrasDia"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnatrasDia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintStart_toEndOf="@id/menu_lateral_dia"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/textoFechaCalendarioDia"

        android:background="@drawable/calendar_title"
        android:backgroundTint="#1B1B1B"
        android:gravity="center"
        android:drawableStart="@drawable/flecha_atras"
        android:fontFamily="@font/anton"
        android:textSize="16dp"
        android:textColor="#8A8A8A"
        />

    <TextView
        android:id="@+id/textoFechaCalendarioDia"
        android:layout_width="wrap_content"
        android:layout_height="60dp"

        app:layout_constraintStart_toEndOf="@id/btnatrasDia"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:text=""
        android:fontFamily="@font/anton"
        android:textSize="24dp"
        android:textColor="@android:color/white"
        android:background="@drawable/calendar_title"
        android:backgroundTint="#1B1B1B"
        />

        <include
            android:id="@+id/includeEventosDia"
            layout="@layout/scroll_eventos_dia"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/textoFechaCalendarioDia"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
            />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCrearTarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:srcCompat="@drawable/ic_add"
        app:tint="@android:color/white"
        app:backgroundTint="#1B1B1B"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_margin="20dp" />



</androidx.constraintlayout.widget.ConstraintLayout>