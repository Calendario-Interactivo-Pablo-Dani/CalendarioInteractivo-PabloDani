<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/boton_mes_anterior"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textNombreCalendario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/calendar_title"
            android:backgroundTint="#1B1B1B"
            android:gravity="center"
            android:drawableEnd="@drawable/flecha_atras"
            android:fontFamily="@font/anton"
            android:textSize="16dp"
            android:textColor="#8A8A8A"
            >

        </androidx.appcompat.widget.AppCompatButton>

        <TextView
            android:id="@+id/nombre_mes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marzo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/boton_mes_siguiente"
            app:layout_constraintStart_toEndOf="@id/boton_mes_anterior"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/calendar_title"
            android:backgroundTint="#1B1B1B"
            android:gravity="center"
            android:textSize="16dp"
            android:fontFamily="@font/anton"
            android:elevation="2dp"
            android:translationZ="2dp"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/boton_mes_siguiente"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/textNombreCalendario"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/calendar_title"
            android:backgroundTint="#1B1B1B"
            android:gravity="center"
            android:drawableStart="@drawable/flecha_alante"
            android:fontFamily="@font/anton"
            android:textSize="16dp"
            android:textColor="#8A8A8A"
            >

        </androidx.appcompat.widget.AppCompatButton>


</androidx.constraintlayout.widget.ConstraintLayout>