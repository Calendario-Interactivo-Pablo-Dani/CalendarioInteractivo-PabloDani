<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:backgroundTint="#1B1B1B"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- INDICADOR DE COLOR -->
        <View
            android:id="@+id/indicador_color"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/casilla_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/bloque_fecha"
            app:layout_constraintBottom_toBottomOf="@id/bloque_fecha"/>

        <!-- BLOQUE FECHA + HORA -->
        <LinearLayout
            android:id="@+id/bloque_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/indicador_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/dia_evento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#B0B0B0"/>

            <TextView
                android:id="@+id/mes_evento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEB"
                android:layout_marginStart="6dp"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#B0B0B0"/>

            <TextView
                android:id="@+id/hora_evento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:30"
                android:layout_marginStart="8dp"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#B0B0B0"/>
        </LinearLayout>

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/titulo_evento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Presentación proyecto"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/bloque_fecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>